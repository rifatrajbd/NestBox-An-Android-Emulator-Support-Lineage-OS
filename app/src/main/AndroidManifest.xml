<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Machines run as foreground services (one process each) with an ongoing notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Run with screen off" keeps the CPU awake for AFK apps -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Floating window and floating ball over other apps (Xiaomi: "Display pop-up windows") -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Xiaomi setup: battery "No restrictions" fallback screen -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Boot logs and the shared folder live in /sdcard/Nestbox (targetSdk 28 keeps legacy storage access) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- Wireless debugging pairing with this phone's own adbd -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Transfer › Apps lists the phone's launchable apps -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".NestboxApp"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nestbox">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One service class per machine slot, because a manifest service has one process -->
        <service
            android:name=".service.VmService1"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":vm1">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-started virtual Android machine until the user stops it" />
        </service>
        <service
            android:name=".service.VmService2"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":vm2">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-started virtual Android machine until the user stops it" />
        </service>
        <service
            android:name=".service.VmService3"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":vm3">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-started virtual Android machine until the user stops it" />
        </service>
        <service
            android:name=".service.VmService4"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":vm4">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a user-started virtual Android machine until the user stops it" />
        </service>

        <service
            android:name=".adb.PairingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Waits for the user to type this phone's wireless debugging pairing code" />
        </service>
    </application>
</manifest>
